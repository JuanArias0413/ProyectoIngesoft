# Copia este archivo a .env (el agente lo genera automáticamente). No subas .env al repositorio.
NODE_ENV=development
PORT=3000
TZ=America/Bogota

# PostgreSQL de Homebrew: usuario del sistema operativo, sin contraseña, puerto 5432
DATABASE_URL=postgresql://TU_USUARIO_SO@localhost:5432/sgec_dev
TEST_DATABASE_URL=postgresql://TU_USUARIO_SO@localhost:5432/sgec_test

# Cambia este valor (mínimo 32 caracteres aleatorios)
SESSION_SECRET=cambia-este-valor-por-uno-aleatorio-de-32-caracteres-o-mas

# Carpeta de adjuntos (fuera de public/)
STORAGE_DIR=./storage

<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Sistema de Gestión de Escenarios y Bienes Culturales — Secretaría de Cultura de Pereira">
  <title>{{ title | default("SGEC — Secretaría de Cultura de Pereira") }}</title>

  {# Estilos de terceros y locales #}
  <link rel="stylesheet" href="/vendor/pico.min.css">
  <link rel="stylesheet" href="/css/app.css">

  {# Scripts de terceros servidos localmente #}
  <script src="/vendor/htmx.min.js"></script>

  {% block head %}{% endblock %}
</head>
<body>
  {# Barra de Navegación Institucional con filtro por rol #}
  {% include "partials/nav.njk" %}

  {# Contenido Principal #}
  <main class="main-content" id="main-content">
    {# Mensajes Flash (éxito, error, advertencia, información) #}
    {% include "partials/flash.njk" %}

    {% block content %}{% endblock %}
  </main>

  {# Pie de página institucional #}
  <footer class="site-footer">
    <div class="container">
      <p style="margin: 0; line-height: 1.4;">
        <strong>SGEC</strong> — Sistema de Gestión de Escenarios y Bienes Culturales · Release 1.0<br>
        <small>Secretaría de Cultura · Alcaldía de Pereira · Proyecto Académico</small>
      </p>
    </div>
  </footer>

  {# Pie discreto exclusivo para impresión A4 (A-13) #}
  <div class="print-footer-notice" aria-hidden="true">
    Formato generado por SGEC — proyecto académico · Secretaría de Cultura de Pereira
  </div>

  {# Script para interacción de navegación móvil #}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var navToggle = document.getElementById('nav-menu-toggle');
      var navContent = document.getElementById('nav-content');
      if (navToggle && navContent) {
        navToggle.addEventListener('click', function() {
          var isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
          navToggle.setAttribute('aria-expanded', !isExpanded);
          navContent.classList.toggle('is-active');
        });
      }
    });
  </script>

  {% block scripts %}{% endblock %}
</body>
</html>

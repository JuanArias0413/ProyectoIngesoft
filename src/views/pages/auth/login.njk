{% extends "layouts/base.njk" %}

{% block content %}
<div style="display: flex; justify-content: center; align-items: center; min-height: 70vh; padding: 1.5rem 0;">
  <article class="card card-civic-accent" style="width: 100%; max-width: 480px; margin: 0 auto; padding: 2.25rem 2rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -2px rgba(0, 0, 0, 0.05);">
    <div style="text-align: center; margin-bottom: 1.75rem;">
      <div style="display: inline-flex; align-items: center; justify-content: center; width: 54px; height: 54px; border-radius: 12px; background-color: #fef2f2; color: #cf1020; font-size: 1.65rem; margin-bottom: 0.85rem; border: 1px solid #fecaca; box-shadow: 0 2px 4px rgba(207, 16, 32, 0.08);">
        &#127963;
      </div>
      <h1 style="font-size: 1.65rem; color: #0f172a; font-weight: 800; margin-bottom: 0.35rem; letter-spacing: -0.02em;">
        Iniciar Sesión
      </h1>
      <p style="color: #64748b; font-size: 0.9rem; margin: 0; line-height: 1.4;">
        Secretaría de Cultura · Alcaldía de Pereira<br>
        <span style="font-size: 0.825rem; color: #94a3b8;">Sistema de Gestión de Escenarios y Bienes Culturales</span>
      </p>
    </div>

    {% if error %}
      <div class="alert alert-error" role="alert" style="margin-bottom: 1.25rem;">
        <span class="alert-icon" aria-hidden="true">&#10007;</span>
        <div class="alert-content">{{ error }}</div>
      </div>
    {% endif %}

    <form action="/login" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">

      <div class="form-group">
        <label for="email">
          Correo Electrónico Institucional
          <span style="color: #cf1020; font-weight: 700;">*</span>
          <small>Ejemplo: auxiliar@sgec.local</small>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="nombre@sgec.local"
          value="{{ email | default('') }}"
          required
          autocomplete="email"
          autofocus
        >
      </div>

      <div class="form-group">
        <label for="password">
          Contraseña
          <span style="color: #cf1020; font-weight: 700;">*</span>
          <small>Ingrese su clave de acceso</small>
        </label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="••••••••••••"
          required
          autocomplete="current-password"
        >
      </div>

      <button type="submit" style="width: 100%; margin-top: 1.25rem; font-weight: 700; padding: 0.75rem; font-size: 1rem;">
        Ingresar al Sistema
      </button>
    </form>

    <footer style="margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid #e2e8f0; font-size: 0.85rem; color: #64748b;">
      <details style="border: 1px solid #e2e8f0; border-radius: 6px; padding: 0.75rem; background-color: #f8fafc; margin: 0;">
        <summary style="cursor: pointer; color: #0f172a; font-weight: 600; font-size: 0.825rem;">
          Usuarios de prueba para evaluación
        </summary>
        <div style="margin-top: 0.75rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.775rem; color: #334155; line-height: 1.6;">
          <div style="display: flex; justify-content: space-between; padding: 0.2rem 0; border-bottom: 1px dashed #e2e8f0;"><span>Auxiliar:</span> <code>auxiliar@sgec.local</code></div>
          <div style="display: flex; justify-content: space-between; padding: 0.2rem 0; border-bottom: 1px dashed #e2e8f0;"><span>Jefe de Oficina:</span> <code>jefe@sgec.local</code></div>
          <div style="display: flex; justify-content: space-between; padding: 0.2rem 0; border-bottom: 1px dashed #e2e8f0;"><span>Oficina Jurídica:</span> <code>juridica@sgec.local</code></div>
          <div style="display: flex; justify-content: space-between; padding: 0.2rem 0; border-bottom: 1px dashed #e2e8f0;"><span>Secretario de Cultura:</span> <code>secretario@sgec.local</code></div>
          <div style="display: flex; justify-content: space-between; padding: 0.2rem 0; border-bottom: 1px dashed #e2e8f0;"><span>Técnico Operativo:</span> <code>operativo@sgec.local</code></div>
          <div style="display: flex; justify-content: space-between; padding: 0.2rem 0;"><span>Técnico Mantenimiento:</span> <code>mantenimiento@sgec.local</code></div>
          <div style="margin-top: 0.5rem; padding-top: 0.4rem; border-top: 1px solid #cbd5e1; font-weight: 600; color: #b45309; text-align: center;">
            Contraseña general: <code>Cambiar123!</code>
          </div>
        </div>
      </details>
    </footer>
  </article>
</div>
{% endblock %}

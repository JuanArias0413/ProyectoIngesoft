{% extends "layouts/base.njk" %}

{% block content %}
<div style="display: flex; justify-content: center; align-items: center; min-height: 50vh;">
  <article class="card" style="max-width: 600px; width: 100%; text-align: center; padding: 2.5rem 2rem;">
    <div style="font-size: 3rem; color: #f59f00; margin-bottom: 0.5rem;" aria-hidden="true">&#9888;</div>
    <h1 style="color: var(--sgec-primary); font-size: 1.75rem; margin-bottom: 0.5rem;">
      {{ statusCode | default(400) }} · No fue posible procesar la solicitud
    </h1>
    <p style="font-size: 1.05rem; color: var(--sgec-text); margin-bottom: 1rem;">
      {{ message | default("La solicitud enviada no cumple con las validaciones de negocio o presenta un conflicto de información.") }}
    </p>
    {% if details %}
      <div style="text-align: left; background: #fff9db; border: 1px solid #ffe066; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1.5rem; font-size: 0.875rem;">
        <strong>Detalles de validación:</strong>
        <pre style="margin: 0.5rem 0 0; font-size: 0.8rem; background: transparent; padding: 0;">{{ details | dump(2) }}</pre>
      </div>
    {% endif %}
    <p style="font-size: 0.875rem; color: var(--sgec-text-muted); margin-bottom: 2rem;">
      Por favor verifique los datos ingresados e intente nuevamente. Si el error persiste, consulte las reglas de negocio del trámite.
    </p>
    <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
      <button type="button" class="outline secondary" onclick="history.back()" style="padding: 0.65rem 1.5rem; margin: 0;">
        &larr; Volver a la pantalla anterior
      </button>
      <a href="/" role="button" class="primary" style="padding: 0.65rem 1.5rem; text-decoration: none; margin: 0;">
        Ir al Inicio
      </a>
    </div>
  </article>
</div>
{% endblock %}
